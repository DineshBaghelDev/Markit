# Copy only the missing values into .env.local. Never commit real credentials.
# Convex dev writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL automatically.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Existing CONVEX_URL is also supported as a fallback.
CONVEX_URL=

# Vercel AI Gateway key (on Vercel, OIDC is used automatically).
AI_GATEWAY_API_KEY=
# Optional AI Gateway model string; defaults to openai/gpt-5-mini.
AI_MODEL=

CRUSTDATA_API_KEY=
