# Copy only the missing values into .env.local. Never commit real credentials.
# Convex dev writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL automatically.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Existing CONVEX_URL is also supported as a fallback.
CONVEX_URL=

OPENAI_API_KEY=
# Set an available model ID before adding AI features.
OPENAI_MODEL=

CRUSTDATA_API_KEY=
