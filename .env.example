# Copy only the missing values into .env.local. Never commit real credentials.
# Convex dev writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL automatically.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Existing CONVEX_URL is also supported as a fallback.
CONVEX_URL=

# LLM option A: local OpenAI-compatible server (codex-as-api on http://127.0.0.1:18080/v1).
LLM_BASE_URL=
LLM_API_KEY=
# LLM option B: Vercel AI Gateway (leave LLM_BASE_URL empty; on Vercel, OIDC is used automatically).
AI_GATEWAY_API_KEY=
# Model ID: codex-as-api default gpt-6.1-sol; AI Gateway default openai/gpt-5-mini.
AI_MODEL=

# on = record/replay LLM and Crustdata responses in .demo-cache/ (avoids repeat spend).
DEMO_CACHE=

CRUSTDATA_API_KEY=
